# PostgreSQL для локального запуска бота и миграций.
DATABASE_URL=postgres://giveaway:local_dev_only@127.0.0.1:5432/giveaway?sslmode=disable

# Настройки из config/local.yaml переопределяются переменными окружения.
VK_MODE=longpoll
VK_GROUP_ID=0
VK_TOKEN=community-token
VK_CONFIRMATION=
VK_SECRET=
ADMIN_TOKEN=change-me
CAMPAIGN_START_DATE=
CAMPAIGN_END_DATE=
CAMPAIGN_MAIN_PRIZE=

# Порты и учетные данные docker-compose.
BOT_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=giveaway
POSTGRES_USER=giveaway
POSTGRES_PASSWORD=local_dev_only
